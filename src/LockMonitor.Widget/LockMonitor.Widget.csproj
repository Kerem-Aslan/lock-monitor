<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window pops up when the widget host activates the COM server. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(LockMonitorTfm)</TargetFramework>
    <RootNamespace>LockMonitor</RootNamespace>
    <AssemblyName>LockMonitor.Widget</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Single-project MSIX (same approach as WindowsAppSDK-Samples/Widgets/cs-console-packaged) -->
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- Windows App SDK comes from the framework package (Store installs it as a dependency) -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- .NET runtime is carried inside the package -->
    <SelfContained>true</SelfContained>
    <!-- The DeploymentManager auto-initializer only matters for Main/Singleton package features
         (push notifications etc.). Widgets do not need it, and it throws REGDB_E_CLASSNOTREG
         in a static constructor when the exe runs without package identity. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>

    <!-- Keep the footprint small; source-generated interop only -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied to the output folder so the loose layout can be registered with Add-AppxPackage -Register -->
    <Content Include="Templates\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ProviderAssets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Public\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LockMonitor.Core\LockMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" />
  </ItemGroup>

</Project>
