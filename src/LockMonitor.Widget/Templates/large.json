{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "$data": "${metrics}",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${label}",
              "isSubtle": true,
              "horizontalAlignment": "Center"
            },
            {
              "type": "TextBlock",
              "text": "${value}",
              "size": "ExtraLarge",
              "weight": "${weight}",
              "color": "${color}",
              "horizontalAlignment": "Center",
              "spacing": "None"
            },
            {
              "type": "ColumnSet",
              "$when": "${hasBar}",
              "spacing": "Small",
              "columns": [
                {
                  "type": "Column",
                  "width": "${bar}",
                  "style": "${barStyle}",
                  "minHeight": "4px",
                  "items": []
                },
                {
                  "type": "Column",
                  "width": "${rest}",
                  "style": "emphasis",
                  "minHeight": "4px",
                  "items": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${gpuName}",
      "$when": "${gpuName != ''}",
      "isSubtle": true,
      "size": "Small",
      "horizontalAlignment": "Center",
      "wrap": false,
      "spacing": "Small"
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "Medium",
      "items": [
        {
          "type": "Container",
          "$data": "${details}",
          "spacing": "Small",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${label}",
                      "isSubtle": true
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${valueLong}",
                      "weight": "${weight}",
                      "color": "${color}",
                      "horizontalAlignment": "Right"
                    }
                  ]
                }
              ]
            },
            {
              "type": "ColumnSet",
              "$when": "${hasBar}",
              "spacing": "Small",
              "columns": [
                {
                  "type": "Column",
                  "width": "${bar}",
                  "style": "${barStyle}",
                  "minHeight": "4px",
                  "items": []
                },
                {
                  "type": "Column",
                  "width": "${rest}",
                  "style": "emphasis",
                  "minHeight": "4px",
                  "items": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "Medium",
      "$when": "${count(topProcesses) > 0}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Top processes",
          "isSubtle": true,
          "size": "Small",
          "weight": "Bolder"
        },
        {
          "type": "ColumnSet",
          "$data": "${topProcesses}",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${name}",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${value}",
                  "color": "${color}",
                  "weight": "${weight}",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
