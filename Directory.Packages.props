<Project>
  <!-- Versions verified on nuget.org on 2026-10-31 -->
  <ItemGroup>
    <!-- Component packages instead of the Microsoft.WindowsAppSDK metapackage: the metapackage
         also ships ONNX Runtime, DirectML and WebView2 (~40 MB) that a widget does not use. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
    <PackageVersion Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261008100" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
